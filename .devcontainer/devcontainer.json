// https://containers.dev/implementors/json_reference/
{
	"name": "The Bleep",
	"image": "mcr.microsoft.com/devcontainers/python:3.12",
	"features": {
		// The functional tests drive real shells, and the ones they drive have
		// to be there.
		"ghcr.io/devcontainers/features/docker-in-docker:2": {}
	},
	"onCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends fish tcsh zsh",
	"postCreateCommand": "pip install -r requirements.txt && pip install -e .",
	"customizations": {
		"vscode": {
			"extensions": ["ms-python.python", "ms-python.flake8"]
		}
	}
}
