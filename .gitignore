# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/

# PyBuilder
target/

.env
.idea

# vim temporary files
.*.swp

# Benchmark subjects, and every result but the canonical one. `final.json` is
# the run the README's table is written from, so it is committed on purpose --
# named here rather than force-added, so that keeping it does not depend on
# somebody remembering `git add -f`.
bench/.venvs/
bench/results/*
!bench/results/final.json

# CodeGraph's local index of this checkout
.codegraph/

# Scratch notes and triage that belong to working on this, not to the project.
# This lived in .git/info/exclude, which is one machine's file: a `git add -f`
# or a fresh clone was all it took to publish 25 KB of working notes.
.scratch/

# pytest, tox and virtualenv leftovers not covered above
.pytest_cache/
.benchmarks/
venv/
.venv/
